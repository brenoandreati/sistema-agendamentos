# Banco de dados PostgreSQL (ex.: Neon, Supabase, Railway)
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?schema=public"

# Chave secreta para login e criptografia (gere uma com: openssl rand -hex 32)
AUTH_SECRET=""

# Endereço público do sistema (usado nos links de pagamento e webhooks)
APP_URL="https://seu-dominio.com.br"

# Avisos no celular do dono do negócio (gere com: npm run vapid)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# E-mails de quem acessa /admin (separados por vírgula). Precisa ter conta de negócio com esse e-mail.
ADMIN_EMAILS=""

# WhatsApp do suporte da plataforma, com DDD (botão "Suporte" e "Esqueci minha senha")
SUPPORT_WHATSAPP=""
